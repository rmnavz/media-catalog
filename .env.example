# media-catalog local secrets — copy to .env (never commit .env)
# Repo: https://github.com/rmnavz/media-catalog (CC0 1.0)
# Needed only for: python tools/validate_catalog.py --live
# Static validation (default) does not need any secrets.

# TMDB — use either an API key or a read access token
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# TheTVDB v4
TVDB_API_KEY=
# Optional subscriber PIN (required for some TVDb plans)
TVDB_PIN=
